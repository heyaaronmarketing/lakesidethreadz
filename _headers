# ---- Security headers (apply to everything) ----
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# ---- Cache policy ----
# Static asset long-term cache; HTML revalidates
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# RSS feeds must be served as application/rss+xml — strict validators
# (Buffer, IFTTT) reject application/xml.
/blog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=600

# IndexNow verification file — must be served as text/plain, no-cache
# so re-verifications hit fresh bytes.
/a97321ae687a3df3c2756734fe4bef42.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
